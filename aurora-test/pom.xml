<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.aurora</groupId>
        <artifactId>aurora-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    
    <artifactId>aurora-test</artifactId>
    <description>极光 AI 单元测试模块</description>

    <dependencies>
        <!-- 引入 Framework 模块，自动包含 Common 和 Redis 依赖 -->
        <dependency>
            <groupId>com.aurora</groupId>
            <artifactId>aurora-framework</artifactId>
            <version>${aurora.version}</version>
        </dependency>

        <!-- 引入 AI 模块 -->
        <dependency>
            <groupId>com.aurora</groupId>
            <artifactId>aurora-ai</artifactId>
            <version>${aurora.version}</version>
        </dependency>

        <!-- 引入 Admin 模块，用于 Controller 测试 -->
        <dependency>
            <groupId>com.aurora</groupId>
            <artifactId>aurora-admin</artifactId>
            <version>${aurora.version}</version>
        </dependency>

        <!-- Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
        </dependency>
        
         <!-- JUnit -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
