# 复制为 .env 并改值。.env 含密钥,务必加入 .gitignore、不要提交。
# ⚠️ 安全要求(application-prod.yml 中无默认值,缺失则拒绝启动):

# 数据库
MYSQL_DB=aurora
MYSQL_PASSWORD=请改成强密码

# Redis
REDIS_PASSWORD=请改成强密码

# JWT 签名密钥:HS512 要求 ≥64 字节(@PostConstruct 会校验,过短拒启)
AURORA_TOKEN_SECRET=请生成不少于64字节的随机强密钥xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 小程序端令牌签名密钥:HS256 要求 ≥32 字节,与上面的后台密钥分开设(缺失或过短拒启)
MOBILE_TOKEN_SECRET=请生成不少于32字节的随机强密钥xxxxxxxxxxxxxxxxxxxx

# 数据加密(AES-GCM):key 16/24/32 字节,iv 12 字节;用于 sys_ai_model.api_key 等加密
# ⚠️ 生产的 key 一旦确定不要更改,否则已加密入库的模型 key 无法解密
AURORA_ENCRYPT_KEY=请改成32字节随机密钥xxxxxxxxxxxxxxxxxxxxxxxx
AURORA_ENCRYPT_IV=请改成12字节IV

# CORS 允许的前端来源(逗号分隔),如 https://your-domain.com
AURORA_CORS_ORIGINS=https://your-domain.com

# 前端对外端口(宝塔通常用其 nginx 做 443→此端口 的反代)
WEB_PORT=80
